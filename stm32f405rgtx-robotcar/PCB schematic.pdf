(function _HighlightRect\(pageIndex, left, top, right, bottom\){this.selectPageNthWord\(pageIndex, 0, bScroll=false\);                                                 \r\nvar lastDist = -1.0;                                                                 \                \r\nvar lastIndex = -1;                                                                                  \r\nvar matInv = \(new Matrix2D\).fromRotated\(this, pageIndex\).invert\(\);                                   \r\nfor \(var i = 0; i \< this.getPageNumWords\(pageIndex\); i++\) {                                          \r\n    var quads = matInv.transform\(this.getPageNthWordQuads\(pageIndex, i\)\).toString\(\).split\(","\);      \r\n    var qLeft = Math.min\(Math.min\(quads[0], quads[\2]\), Math.min\(quads[4], quads[6]\)\);                \r\n    var qRight = Math.max\(Math.max\(quads[0], quads[2]\), Math.max\(quads[4], quads[6]\)\);               \r\n    var qTop = Math.min\(Math.min\(quads[1], quads[3]\), Math.min\(quads[5], quads[7]\\)\);                 \r\n    var qBottom = Math.max\(Math.max\(quads[1], quads[3]\), Math.max\(quads[5], quads[7]\)\);              \r\n    if \(\(left >= qRight\) || \(right <= qLeft\) || \(top >= qBottom\) || \(bottom <= qTop\)\) continue;      \r\n   \ var dist =   Math.abs\(left - qLeft\) + Math.abs\(right - qRight\)                                   \r\n               + Math.abs\(top - qTop\) + Math.abs\(bottom - qBottom\);                                  \r\n    if \(\(lastDist >= 0\) && \(lastDist\ <= dist\)\) continue;                                             \r\n    lastDist = dist;                                                                                 \r\n    lastIndex = i;                                                             \                      \r\n}                                                                                                    \r\nif \(lastIndex >= 0\) this.selectPageNthWord\(pageIndex, lastIndex, bScroll=false\);                     })/S/JavaScript>>endobj155 0 obj<</JS(function ShowCompProps_4A0A72AD3E3B47178DA6693260B0F978\(\){var sChoice = app.popUpMenu\("Comment: TLJB227M006R0500","Component Kind: Standard","Description: No Description Available","Footprint: CAP_TLJ-B_KAV","Ibis Model: ","Library Name: TLJB227M006R05\00.SchLib","Library Reference: TLJB227M006R0500","Mfr_Name: KYOCERA AVX","PCB3D: ","Pin Info: ","RefDes: ","Signal Integrity: ","Simulation: ","Type: "\); if \(sChoice\) {var nUrlPos = sChoice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos \!== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sChoice.substr\(nPathPos+2\)\);};};})/S/JavaScript>>endobj156 0 obj<</JS(function ShowCompProps_FCED639031C549F59DE71362682C56FE\(\){var sChoice = app.popUpMenu\("BOM\\u540D\\u79F0: \\u65E0\\u6781\\u6027\\u8D34\\u7247\\u7535\\u5BB9","Comment: 10uF","Component Kind: Standard","Description: \\u8D34\\u7247\\u7535\\u5BB9","Footpri\nt: C 0603_L","Ibis Model: ","Library Name: 0.1 - \\u7535\\u963B-\\u7535\\u5BB9-\\u7535\\u611F.SchLib","Library Reference: C","PCB3D: ","Pin Info: ","Signal Integrity: ","Simulation: ","\\u552F\\u4E00\\u51FA\\u552E\\u5E97\\u94FA\\u7F51\\u5740: https://sho\p463601444.taobao.com","\\u6DD8\\u5B9DID: \\u5C01\\u88C5\\u5E93\\u6765\\u81EA\\u6DD8\\u5B9D ID\\uFF1A\\u9EC4\\u6676\\u5B9D\\u77F3","\\u8054\\u7CFB\\u552E\\u540E\\uFF0C\\u6280\\u672F\\u652F\\u6301: https://shop463601444.taobao.com"\); if \(sChoice\) {var n\UrlPos = sChoice.search\(/:\\s\(\(http|https|ftp\):\\/\\/\).+/\); if \(nUrlPos !== -1\) {app.launchURL\(sChoice.substr\(nUrlPos+2\), true\);} else {var nPathPos = sChoice.search\(/:\\s\(\(\\/\)|\(\\\\\\\\\)\).+/\); if \(nPathPos !== -1\) app.openDoc\(sCho\ice.substr\(nPathPos+2\)\);};};})/S/JavaScript>>endobj157 0 obj<</JS(function ShowCompProps_3270F89D8689470E83A08B9DA9204F6A\(\){v